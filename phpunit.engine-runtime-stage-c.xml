<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache/engine-runtime-stage-c"
>
    <testsuites>
        <testsuite name="External contracts simulated">
            <directory>tests/ExternalContracts</directory>
            <file>tests/Feature/GamadCoreClientTest.php</file>
            <file>tests/Feature/FederationContinuationTest.php</file>
            <file>tests/Feature/ZumraMembershipPaymentTest.php</file>
            <file>tests/Feature/ContributionTest.php</file>
            <file>tests/Feature/ZahabAcquisitionTest.php</file>
            <file>tests/Feature/ProjectBrainTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <groups>
        <exclude>
            <group>legacy-frontend</group>
        </exclude>
    </groups>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_TIMEZONE" value="UTC" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="ZUMRA_PAYMENT_ENABLED" value="false" force="true"/>
        <env name="GENIUSPAY_SANDBOX_ACTIVATION_ALLOWED" value="false" force="true"/>
        <env name="DEEPSEEK_ENABLED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
