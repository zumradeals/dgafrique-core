APP_NAME="DG Afrique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dgafrique
DB_USERNAME=dgafrique
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=dg_afrique_portal_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# URL canonique incluant le préfixe versionné /api/v1.
GAMAD_CORE_BASE_URL=https://console.dgafrique.com/api/v1
GAMAD_CORE_PRODUCT_REF=
GAMAD_CORE_AUTHN_REF=
GAMAD_CORE_CONNECT_SECRET=
GAMAD_CORE_TIMEOUT=8
GAMAD_CORE_CONNECT_TIMEOUT=3

# PVB-I02 — intelligence conversationnelle du Cerveau Projet.
# La clé reste uniquement dans le .env du serveur et ne doit jamais être commitée.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_TOKENS=900

# Passerelle fédérée vers GamaDrive (CAP-CORE-022 côté Core).
GAMADRIVE_FEDERATION_PRODUCT_REF=PRD-GAMAD-002
GAMADRIVE_FEDERATION_CALLBACK_URL=https://gamadrive.dgafrique.com/federation/callback

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dgafrique.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CAP-007B — activer avec des identifiants GeniusPay LIVE ou SANDBOX valides selon GENIUSPAY_ENVIRONMENT.
ZUMRA_PAYMENT_ENABLED=false
ZUMRA_MEMBERSHIP_FEE_XOF=500
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_ENVIRONMENT=live
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_TIMEOUT=15
# Off par défaut partout. N'active JAMAIS automatiquement selon APP_ENV — geste opérationnel
# conscient uniquement, à désactiver dès que de vrais membres paient pour de vrai (fiche CAP-007B).
GENIUSPAY_SANDBOX_ACTIVATION_ALLOWED=false
