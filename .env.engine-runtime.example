APP_NAME="DG Afrique — Engine Runtime"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dgafrique_engine_runtime_001
DB_USERNAME=dgafrique_engine_runtime
DB_PASSWORD=__ENGINE_RUNTIME_DB_PASSWORD__
DB_SSLMODE=prefer
DB_TIMEZONE=UTC

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=dgafrique_engine_runtime_session

CACHE_STORE=redis
CACHE_PREFIX=dgafrique_engine_runtime_001_cache_
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=14
REDIS_CACHE_DB=15
REDIS_PREFIX=dgafrique_engine_runtime_001_database_

GAMAD_CORE_BASE_URL=https://core.test/api/v1
GAMAD_CORE_PRODUCT_REF=PRD-GAMAD-005
GAMAD_CORE_AUTHN_REF=
GAMAD_CORE_CONNECT_SECRET=engine-runtime-not-a-real-secret
GAMAD_CORE_TIMEOUT=2
GAMAD_CORE_CONNECT_TIMEOUT=1

DEEPSEEK_ENABLED=false
DEEPSEEK_DATA_POLICY_VERSION=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://deepseek.test
DEEPSEEK_MODEL=engine-runtime-disabled
DEEPSEEK_CONNECT_TIMEOUT=1
DEEPSEEK_TIMEOUT=2
DEEPSEEK_MAX_TOKENS=100

GAMADRIVE_FEDERATION_PRODUCT_REF=PRD-GAMAD-002
GAMADRIVE_FEDERATION_CALLBACK_URL=https://gamadrive.test/federation/callback
FEDERATION_TRUSTED_PRODUCTS_JSON={}

MAIL_MAILER=array
MAIL_FROM_ADDRESS="runtime@dgafrique.test"
MAIL_FROM_NAME="${APP_NAME}"

ZUMRA_PAYMENT_ENABLED=false
ZUMRA_MEMBERSHIP_FEE_XOF=500
GENIUSPAY_BASE_URL=https://geniuspay.test/api/v1/merchant
GENIUSPAY_ENVIRONMENT=sandbox
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_CONNECT_TIMEOUT=1
GENIUSPAY_TIMEOUT=2
GENIUSPAY_RECONCILIATION_STALE_AFTER_MINUTES=5
GENIUSPAY_RECONCILIATION_BATCH_SIZE=100
GENIUSPAY_RETURN_URL_TTL_MINUTES=1440
GENIUSPAY_SANDBOX_ACTIVATION_ALLOWED=false
